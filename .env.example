# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── database ────────────────────────────────────────────────────────────────
# Port 5434 deliberately: off 5432 (a Postgres already on the host) and off
# 5433 too, since another project's container may already hold that one.
DATABASE_URL=postgresql+psycopg2://sace:sace@localhost:5434/sace_chat

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
SACE_LLM_KEY=
SACE_LLM_BASE=https://api.openai.com/v1
SACE_LLM_MODEL=gpt-4o-mini

# ── KB embeddings ───────────────────────────────────────────────────────────
# EMBEDDING_MODE and EMBEDDING_DIM must agree, because the pgvector column's
# dimension is fixed when the table is created:
#   openai -> 1536   (text-embedding-3-small)
#   mock   -> 384    (offline, no network; thresholds are meaningless under it)
# Changing mode requires ./run.sh reset-kb, which drops and rebuilds the table.
EMBEDDING_MODE=openai
EMBEDDING_DIM=1536

# ── demo API (FastAPI, api/main.py — unused by the live voice dashboard,
# kept for the earlier text-chat demo) ───────────────────────────────────────
API_PORT=8000
# Origin the React dev server runs on (npm run dev, default Vite port).
FRONTEND_ORIGIN=http://localhost:5173

# ── live spectator dashboard (frontend/, watching voice_agent.py) ───────────
# voice_agent.py opens this port itself and pushes retrieval/turn/learning
# events to any connected browser tab — watch-only, nothing flows back in.
VOICE_WS_PORT=8765

# ── hot-path embedder (voice latency) ───────────────────────────────────────
# Which embedder does the LIVE per-turn intent-exemplar match. This never
# touches pgvector, so it may be a different model and dimension from the KB.
#   openai (default) -> reuses the KB vector already computed; no extra call
#   local            -> on-device sentence-transformer, removes a round-trip
# See embeddings.get_hotpath_embedder for the full rule on which embedder is
# used where. pgvector queries ALWAYS use the KB embedder.
EMBED_HOTPATH=openai
# EMBED_HOTPATH_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LiveKit (voice) ─────────────────────────────────────────────────────────
# THIS FILE IS COMMITTED — it is a template, not a secret store. Real keys go in
# .env, which is gitignored. Never paste a live secret below.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Deepgram (STT + TTS) ────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Turn-taking. endpointing_ms is the silence Deepgram waits for before
# finalising a transcript: ~300ms feels natural here, lower clips the caller,
# higher adds dead air. VAD_MIN_SILENCE is Silero's equivalent for barge-in.
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
VAD_MIN_SILENCE=0.30

# ── calling Maya from a phone (scripts/run_renewal.sh) ──────────────────────
# The dashboard is served locally by Vite. To use it from a phone, that page
# has to be reachable AND on a secure origin: getUserMedia refuses the
# microphone on plain http, including on a LAN address, so a same-wifi
# http://192.168.x.x:5173 will load the page and then have no mic. An https
# tunnel is what makes the phone a usable caller.
#
# The tunnel carries only the DASHBOARD. Call audio goes
# phone -> LiveKit Cloud -> agent and never enters it.
#
# Optional — with no token, run_renewal.sh skips the tunnel and everything else
# still runs locally. Alternatively: ngrok config add-authtoken <token>
NGROK_AUTHTOKEN=3IReqIhbD7LV91om9zZUMe8Dwxh_3t7i9WvK1jQYDGCLpqA2V

# ngrok's inspector defaults to :4040, which collides with anything else
# already running ngrok on this machine. run_renewal.sh pins ours here.
NGROK_WEB_PORT=4141
