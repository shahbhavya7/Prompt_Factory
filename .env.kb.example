# Copy to .env.kb and fill in if needed. .env.kb is gitignored — this file is
# the committed template.
#
# This is the ISOLATED renewal-KB database (docker-compose.kb.yml), not the
# shared sace_chat database in .env. Never merge these two files, and never
# point DATABASE_URL below at port 5434 — every entry point on this branch
# refuses to start against anything but SACE_EXPECTED_DB (see sace_chat/db.py).

# ── database (docker-compose.kb.yml: container sace-kb-db, port 5433) ────────
# SACE_KB_PORT overrides the published port, because "free" is not a property
# of a port number. Measured once already: 5433 was held by an unrelated
# project's Postgres, and because the guard in sace_chat/db.py only parsed the
# URL string, connecting to that stranger's server passed the check — it failed
# on password auth, by luck. If `docker compose -f docker-compose.kb.yml up`
# reports "port is already allocated", set this and match DATABASE_URL to it.
# sace_chat.db.verify_connected_database now also refuses a populated database
# that is not this stack's, so a repeat of that mix-up fails loudly.
#SACE_KB_PORT=5435
DATABASE_URL=postgresql+psycopg2://sace:sace@localhost:5433/sace_kb

# The startup guard in sace_chat/db.py refuses to build an engine unless the
# database DATABASE_URL points at matches this name exactly. This is what makes
# a stale DATABASE_URL in someone's shell fail loudly instead of silently
# writing into whatever database that shell happened to be pointed at.
SACE_EXPECTED_DB=sace_kb

# ── KB embeddings — same knobs as .env, kept in sync manually ────────────────
# openai -> 1536 (text-embedding-3-small)   mock -> 384 (offline, no network)
EMBEDDING_MODE=openai
EMBEDDING_DIM=1536
